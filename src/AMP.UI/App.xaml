<Application x:Class="AMP.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AMP.UI.ViewModels"
             xmlns:views="clr-namespace:AMP.UI.Views"
             xmlns:svc="clr-namespace:AMP.UI.Services">
    <Application.Resources>

        <!-- 流程页 DataTemplate：VM 类型 → 独立界面 -->
        <DataTemplate DataType="{x:Type vm:SvdCorrectionViewModel}">
            <views:SvdCorrectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MetrologyJudgeViewModel}">
            <views:MetrologyJudgeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RepeatabilityTestViewModel}">
            <views:RepeatabilityTestView />
        </DataTemplate>

        <!-- 运行日志行模板 -->
        <DataTemplate DataType="{x:Type svc:RunLogLine}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="#8b95a1" FontFamily="Consolas" FontSize="12" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="#5b9bff" FontFamily="Consolas" FontSize="12" Width="42" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#d8dee6" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!-- 共享样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Background" Value="#1a73e8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Background" Value="#2b3440" />
            <Setter Property="Foreground" Value="#e6ebf2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#46505e" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Foreground" Value="#cbd5e1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1c2531" />
            <Setter Property="BorderBrush" Value="#303b4a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9fb3c8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

    </Application.Resources>
</Application>
